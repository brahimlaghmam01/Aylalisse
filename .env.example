APP_NAME=AylaLisse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aylalisse
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Mettre à true en production (site servi en HTTPS) — voir docs/DEPLOYMENT.md
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Les images uploadées (avant/après, témoignages, image hero) sont servies
# depuis storage/app/public via le lien symbolique public/storage. Ne pas
# repasser sur "local" : les URL publiques ne seraient plus générées.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log écrit les e-mails dans storage/logs/laravel.log au lieu de
# les envoyer réellement — pratique en local. Utiliser "smtp" en production.
MAIL_MAILER=log
# MAIL_SCHEME remplace l'ancienne variable MAIL_ENCRYPTION dans ce projet
# (Laravel 12 / Symfony Mailer) : "smtp" (STARTTLS, port 587) ou "smtps"
# (TLS implicite, port 465).
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@aylalisse.fr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Compte admin de développement (AdminSeeder) — à changer avant toute mise
# en production. Ne jamais committer de vrais identifiants ici.
ADMIN_EMAIL=admin@aylalisse.fr
ADMIN_PASSWORD=change-me
